        $( ".tools-box-bookmark" ).on( "click", function() {
            var $this = jQuery('.tools-box-bookmark');
            var added = $this.attr('data-added');
            var filmId = $this.attr('data-filmid');
            if (typeof added === 'string' && added === 'true') {
                added = true;
            } else {
                added = false;
            }
            if (added) {
                $.ajax({
                    method: 'GET',
                    url: "https://yanhh3d.pw/ajax/bookmark/add",
                    data: {
                        bookmark: false,
                        movie_id: filmId,
                        type: "remove"
                    },
                    dataType: 'json',
                    success: function(data) {
                        if (data.status === 1) {
                            $this.addClass('normal');
                            $this.removeClass('added');
                            $this.attr('data-added', 'false');
                            $this.find('.text-bookmark').html('<i class="fas fa-plus mr-2"></i>Yêu thích');
                            $(".anisc-poster").notify("Bạn đã xóa phim yêu thích thành công!", "warn");
                        } else {
                            $(".anisc-poster").notify("Đăng nhập để lưu phim yêu thích", "error");
                        }
                    }
                });
            } else {
                $.ajax({
                    method: 'GET',
                    url: "https://yanhh3d.pw/ajax/bookmark/add",
                    data: {
                        bookmark: true,
                        movie_id: filmId,
                        type: "add"
                    },
                    dataType: 'json',
                    success: function(data) {
                        if (data.status === 1) {
                            $this.addClass('added');
                            $this.removeClass('normal');
                            $this.attr('data-added', 'true');
                            $this.find('.text-bookmark').html('Đã thêm');
