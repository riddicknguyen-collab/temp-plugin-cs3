    <script>
        function LoadLichChieu(days) {
            let DivLichChieu = $('#LichChieuPhim');
            let Tab = $(`#thu-${days}`);
            if (Tab.hasClass("active")) {
                return;
            }
            $('.lichchieu').removeClass('active');
            Tab.addClass('active');
            let setting = {
                type: "POST",
                url: 'https://yanhh3d.pw/ajax/sever/load-lich-chieu',
                data: {
                    days: days
                },
                headers: {
                    "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr("content"),
                },
                dataType: "json",
                beforeSend: function() {
                    DivLichChieu.html(``);
                },
                success: function(data) {
                    DivLichChieu.html(data.data);
                },
                error: function(error) {
                    DivLichChieu.html(``);
                }
            };
            $.ajax(setting);
        }
        $('#pull').click(function(event) {
            event.preventDefault();
            event.stopPropagation();
            $('.menu').slideToggle();
        });
    </script>
    <script>
        var $today = 'tue';
        LoadLichChieu($today);
        document.activeElement.blur();
    </script>
        
    
    
    
    

    
