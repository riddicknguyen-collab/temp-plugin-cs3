    <style>
        .notice-panel-wrap {
            margin: 10px 0 4px;
            max-width: 100%;
            overflow: hidden;
        }
        .notice-panel-wrap + #main-wrapper #ani_detail,
        .notice-panel-wrap + #main-wrapper.layout-page-detail #ani_detail {
            margin-top: 10px;
        }
        .notice-panel {
            position: relative;
            padding: 10px 12px 10px 48px;
            background: linear-gradient(180deg, rgba(30, 32, 40, 0.9), rgba(20, 21, 27, 0.9));
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }
        .notice-panel-toggle {
            position: absolute;
            top: 12px;
            left: 10px;
            width: 30px;
            height: 30px;
            border: none;
            border-radius: 50%;
            background: linear-gradient(135deg, #ff5858, #e01e1e);
            color: #fff;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(224, 30, 30, 0.45);
            transition: transform 0.2s ease;
            transform-origin: center 60%;
        }
        .notice-panel-toggle i {
            display: inline-block;
            animation: bell-ring 2.5s ease-in-out infinite;
            transform-origin: center 60%;
        }
        .notice-panel-toggle::after {
            content: "";
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            border: 2px solid rgba(224, 30, 30, 0.5);
            animation: bell-pulse 2.5s ease-out infinite;
        }
        .notice-panel-toggle:hover { transform: scale(1.08); }
        .notice-panel-toggle:hover i { animation-play-state: paused; }
        @keyframes bell-ring {
            0%, 65%, 100% { transform: rotate(0deg); }
            70% { transform: rotate(14deg); }
            75% { transform: rotate(-12deg); }
            80% { transform: rotate(10deg); }
            85% { transform: rotate(-8deg); }
            90% { transform: rotate(5deg); }
            95% { transform: rotate(-3deg); }
        }
        @keyframes bell-pulse {
            0% { transform: scale(1); opacity: 0.7; }
            70% { transform: scale(1); opacity: 0.7; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        @media (prefers-reduced-motion: reduce) {
            .notice-panel-toggle i,
            .notice-panel-toggle::after { animation: none; }
        }
        .notice-panel-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .notice-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            transition: background 0.2s ease, border-color 0.2s ease;
        }
        .notice-item:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.12);
        }
        .ni-icon {
            flex: 0 0 auto;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 12px;
        }
        .ni-icon-red   { background: linear-gradient(135deg, #ff6a6a, #e01e1e); }
        .ni-icon-blue  { background: linear-gradient(135deg, #4f9bff, #2563eb); }
        .ni-icon-green { background: linear-gradient(135deg, #4ade80, #16a34a); }
        .ni-body {
            flex: 1 1 auto;
            min-width: 0;
            line-height: 1.3;
        }
        .ni-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: #f3f4f6;
        }
        .ni-desc {
            font-size: 12px;
            color: #9ca3af;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .ni-desc span { color: #ffd166; font-weight: 600; }
        .ni-action {
            flex: 0 0 auto;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-width: 100%;
        }
        .ni-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 11.5px;
            font-weight: 600;
            color: #fff !important;
            text-decoration: none;
            white-space: nowrap;
            transition: transform 0.15s ease, filter 0.15s ease;
            max-width: 100%;
        }
        .ni-btn:hover { transform: translateY(-1px); filter: brightness(1.08); }
        .ni-btn-red       { background: linear-gradient(135deg, #ff5f6d, #e01e1e); }
        .ni-btn-facebook  { background: #1877f2; }
        .ni-btn-messenger { background: linear-gradient(135deg, #00c6ff, #0084ff, #a033ff); }
        .ni-btn-discord   { background: #5865f2; }
        .ni-btn-green     { background: linear-gradient(135deg, #4ade80, #16a34a); }
        .ni-btn-text-short { display: none; }
    
        @media (max-width: 767px) {
            .notice-panel-wrap { margin: 8px 0 4px; }
            .notice-panel-wrap > .container {
                padding-left: 10px;
                padding-right: 10px;
            }
            .notice-panel {
                padding: 8px;
                border-radius: 12px;
            }
            .notice-panel-toggle {
                position: static;
                width: 26px;
                height: 26px;
                font-size: 11px;
                margin-bottom: 6px;
                flex-shrink: 0;
            }
            .notice-panel-toggle::after { display: none; }
            .notice-panel-list { gap: 5px; }
            .notice-item {
                display: grid;
                grid-template-columns: 24px minmax(0, 1fr);
                grid-template-rows: auto auto;
                gap: 5px 8px;
                padding: 7px 8px;
                align-items: center;
            }
            .ni-icon {
                width: 24px;
                height: 24px;
                font-size: 10px;
                grid-row: 1;
            }
            .ni-body {
                grid-column: 2;
                min-width: 0;
            }
            .ni-title {
                font-size: 11px;
                line-height: 1.2;
            }
            .ni-desc { display: none; }
            .ni-action {
                grid-column: 1 / -1;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 5px;
                width: 100%;
            }
            .notice-item--single .ni-action {
                grid-template-columns: 1fr;
            }
            .ni-btn {
                padding: 6px 5px;
                font-size: 10.5px;
                gap: 4px;
                min-width: 0;
                white-space: normal;
                line-height: 1.2;
                text-align: center;
            }
            .ni-btn i { font-size: 12px; flex-shrink: 0; }
        }
    
        @media (max-width: 380px) {
            .ni-btn-text { display: none; }
            .ni-btn-text-short { display: inline; }
            .ni-btn { padding: 7px 4px; }
        }
    </style>
    <div class="notice-panel-wrap">
        <div class="container">
            <div class="">
                <div class="notice-panel-list">
                
                    <div class="notice-item notice-item--single">
                        <div class="ni-icon ni-icon-red"><i class="fas fa-link"></i></div>
                        <div class="ni-body">
                            <div class="ni-title">Lưu hoặc nhớ ngay link rút gọn để truy cập sẽ tự chuyển đến tên miền mới khi nhà mạng chặn</div>
                        </div>
                        <div class="ni-action">
                            <a href="https://bit.ly/yanhh3d" class="ni-btn ni-btn-red">bit.ly/yanhh3d</a>
                        </div>
                    </div>
                    <div class="notice-item">
                        <div class="ni-icon ni-icon-blue"><i class="fas fa-users"></i></div>
                        <div class="ni-body">
                            <div class="ni-title">Tham gia cộng đồng để cập nhật tin tức phim</div>
                        </div>
                        <div class="ni-action">
                            <a href="https://www.facebook.com/yanhh3d.net/" target="_blank" rel="nofollow noopener" class="ni-btn ni-btn-facebook" title="Fanpage Facebook">
