        <div id="sidebar_menu_bg"></div>
<div id="sidebar_menu">
    <button class="btn btn-radius btn-sm btn-secondary toggle-sidebar"><i class="fas fa-angle-left mr-2"></i>Đóng</button>
    <div class="sb-setting">
        <div class="header-setting">
            <div class="hs-toggles">
                <a href="https://yanhh3d.pw/user/bookmark" class="hst-item" title="Watch with friends">
                    <div class="hst-icon"><i class="fas fa-heart mr-2"></i></div>
                    <div class="name"><span>Phim yêu thích</span></div>
                </a>
                <a href="https://yanhh3d.pw/user/history" class="hst-item" data-original-title="Watch random anime">
                    <div class="hst-icon"><i class="fas fa-history mr-2"></i></div>
                    <div class="name"><span>Lịch sử xem</span></div>
                </a>
